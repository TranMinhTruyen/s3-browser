# Test values for the databases in docker-compose.yml and the Rust tests/bench. Fake, never use for real data.
# Usage: docker compose --env-file db/db.env up -d --wait mysql mariadb postgres mssql mongo redis
# (docker-compose.yml has the same values as defaults; keep both in step.)
# Plain KEY=value lines (no quotes, no spaces) so compose and other parsers read them the same way.

DB_HOST=127.0.0.1
DB_NAME=s3b
# One password for all 6 databases (letters + digits so it also satisfies SQL Server's policy).
DB_PASSWORD=S3bTest2026

# Host ports (container ports are fixed). Free ones in test-env: 10030-10036.
MYSQL_PORT=10030
MARIADB_PORT=10031
POSTGRES_PORT=10032
MSSQL_PORT=10033
MONGO_PORT=10034
REDIS_PORT=10035
REDIS_TLS_PORT=10036

# Admin users (MongoDB authenticates against db "admin"; Redis has only a password).
MYSQL_USER=root
MARIADB_USER=root
POSTGRES_USER=postgres
MSSQL_USER=sa
MONGO_USER=root
