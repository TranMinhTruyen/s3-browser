# Giá trị kiểm thử cho các cơ sở dữ liệu trong docker-compose.yml và các bài kiểm thử/đo hiệu năng Rust. Đây là dữ liệu giả, không dùng cho dữ liệu thật.
# Cách dùng: docker compose --env-file db/db.env up -d --wait mysql mariadb postgres mssql mongo redis
# (docker-compose.yml có cùng các giá trị mặc định; hãy giữ hai nơi đồng bộ.)
# Mỗi dòng chỉ gồm KEY=value (không dấu nháy, không khoảng trắng) để Compose và các bộ phân tích khác đọc giống nhau.

DB_HOST=127.0.0.1
DB_NAME=s3b
# Dùng chung một mật khẩu cho cả 6 cơ sở dữ liệu (chữ và số để đáp ứng cả chính sách của SQL Server).
DB_PASSWORD=S3bTest2026

# Cổng phía máy chủ (cổng trong container được cố định). Các cổng còn trống cho test-env: 10030-10036.
MYSQL_PORT=10030
MARIADB_PORT=10031
POSTGRES_PORT=10032
MSSQL_PORT=10033
MONGO_PORT=10034
REDIS_PORT=10035
REDIS_TLS_PORT=10036

# Người dùng quản trị (MongoDB xác thực qua db "admin"; Redis chỉ dùng mật khẩu).
MYSQL_USER=root
MARIADB_USER=root
POSTGRES_USER=postgres
MSSQL_USER=sa
MONGO_USER=root
