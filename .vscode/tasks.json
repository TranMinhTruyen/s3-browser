{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "wails: build debug",
      "type": "shell",
      "command": "go tool wails3 task build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [
        "$go"
      ]
    },
    {
      "label": "vite: dev server",
      "type": "shell",
      "command": "bun run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "wails-dev"
      },
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE v.*",
          "endsPattern": ".*Local:.*"
        }
      }
    },
    {
      "label": "wails: build dev (HMR)",
      "type": "shell",
      "command": "go tool wails3 task build:debug",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "vite: dev server"
      ],
      "group": "build",
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "group": "wails-dev"
      },
      "problemMatcher": [
        "$go"
      ]
    },
    {
      "label": "vite: stop dev server",
      "detail": "Kills whatever holds the Vite dev port, so the server does not outlive the debug session.",
      "type": "shell",
      "command": "$ids = Get-NetTCPConnection -LocalPort 5174 -State Listen -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -Unique; if ($ids) { $ids | ForEach-Object { Stop-Process -Id $_ -Force -ErrorAction SilentlyContinue }; Write-Host 'vite dev server stopped' } else { Write-Host 'vite dev server not running' }",
      "options": {
        "shell": {
          "executable": "powershell.exe",
          "args": [
            "-NoProfile",
            "-NonInteractive",
            "-Command"
          ]
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "group": "wails-dev",
        "close": true
      },
      "problemMatcher": []
    }
  ]
}
