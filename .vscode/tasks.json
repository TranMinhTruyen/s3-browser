{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "wails: build debug",
      "type": "shell",
      "command": "wails build -debug",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [
        "$go"
      ]
    },
    {
      "label": "vite: dev server",
      "type": "shell",
      "command": "bun run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "wails-dev"
      },
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE v.*",
          "endsPattern": ".*Local:.*"
        }
      }
    },
    {
      "label": "wails: build dev (HMR)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/build-dev.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "vite: dev server"
      ],
      "group": "build",
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "group": "wails-dev"
      },
      "problemMatcher": [
        "$go"
      ]
    }
  ]
}