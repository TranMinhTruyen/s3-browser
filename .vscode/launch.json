{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Wails: Debug Go + Frontend HMR",
      "type": "go",
      "request": "launch",
      "mode": "exec",
      "program": "${workspaceFolder}/build/bin/S3Browser-dev.exe",
      "preLaunchTask": "wails: build dev (HMR)",
      "cwd": "${workspaceFolder}",
      "env": {
        "devserver": "localhost:34115",
        "frontenddevserverurl": "http://localhost:5173",
        "loglevel": "Debug"
      }
    },
    {
      "name": "Wails: Debug Go",
      "type": "go",
      "request": "launch",
      "mode": "exec",
      "program": "${workspaceFolder}/build/bin/S3Browser.exe",
      "preLaunchTask": "wails: build debug",
      "cwd": "${workspaceFolder}"
    }
  ]
}