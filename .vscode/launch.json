{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Wails: Debug Go + Frontend HMR",
      "type": "go",
      "request": "launch",
      "mode": "exec",
      "program": "${workspaceFolder}/build/bin/S3Browser-dev.exe",
      "preLaunchTask": "wails: build dev (HMR)",
      "cwd": "${workspaceFolder}",
      "env": {
        "FRONTEND_DEVSERVER_URL": "http://localhost:5174"
      },
      "postDebugTask": "vite: stop dev server"
    },
    {
      "name": "Wails: Debug Go + Browser (Redux DevTools)",
      "type": "go",
      "request": "launch",
      "mode": "exec",
      "program": "${workspaceFolder}/build/bin/S3Browser-server.exe",
      "preLaunchTask": "wails: build dev server (HMR)",
      "cwd": "${workspaceFolder}",
      "env": {
        // Server mode opens no window: browse to http://localhost:8090 in Chrome
        // or Edge, where the Redux DevTools extension is installed. 8080 is the
        // Wails default but is already taken on this machine.
        "WAILS_SERVER_PORT": "8090",
        // Serves the Vite dev server through the same origin, so HMR works and
        // import.meta.env.DEV stays true — the devtools middleware in
        // createStore.ts is gated on it.
        "FRONTEND_DEVSERVER_URL": "http://localhost:5174"
      },
      "postDebugTask": "vite: stop dev server"
    },
    {
      "name": "Wails: Debug Go",
      "type": "go",
      "request": "launch",
      "mode": "exec",
      "program": "${workspaceFolder}/build/bin/S3Browser.exe",
      "preLaunchTask": "wails: build debug",
      "cwd": "${workspaceFolder}"
    }
  ]
}
